  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Th\u1EDDi gian: Sau ng\xE0y l\u1EC5 m\u1EEBng c\u01A1m m\u1EDBi\r\n\u0110\u1ECBa
    \u0111i\u1EC3m: T\u1EA1i c\u1ED9ng \u0111\u1ED3ng ng\u01B0\u1EDDi Bahnar v\xE0
    Jrai \u1EDF Kon Tum.\n\n\u0110\xE2y l\xE0 m\u1ED9t l\u1EC5 h\u1ED9i th\u1EC3
    hi\u1EC7n s\u1EF1 hi\u1EBFu th\u1EA3o c\u1EE7a nh\u1EEFng ng\u01B0\u1EDDi con
    sau khi \u0111\xE3 c\xF3 gia \u0111\xECnh. \u0110\u1ED1i v\u1EDBi nh\u1EEFng
    ng\u01B0\u1EDDi con g\xE1i sau khi \u0111\xE3 k\u1EBFt h\xF4n th\xEC h\u1ECD
    quay v\u1EC1 nh\xE0 cha m\u1EB9 \u0111\u1EC3 l\xE0m \u201CL\u1EC5 t\u1EA1 \u01A1n
    cha m\u1EB9\u201D nh\u1EB1m t\u1EA1 \u01A1n c\xF4ng sinh th\xE0nh v\xE0 d\u01B0\u1EE1ng
    d\u1EE5c c\u1EE7a cha m\u1EB9. Ti\u1EBFp \u0111\xF3, h\u1ECD qu\xE2y qu\u1EA7n
    b\xEAn nhau, \u0103n u\u1ED1ng c\xF9ng nhau trong kho\u1EA3ng 2 ng\xE0y. L\u1EC5
    h\u1ED9i \u0111\u01B0\u1EE3c di\u1EC5n ra \u1EDF c\u1EA3 nh\xE0 ba m\u1EB9 b\xEAn
    ch\u1ED3ng l\u1EABn b\u1ED1 m\u1EB9 b\xEAn v\u1EE3.\nL\u1EC5 t\u1EA1 \u01A1n
    cha m\u1EB9 g\u1ED3m 2 ph\u1EA7n: ph\u1EA7n l\u1EC5 v\xE0 ph\u1EA7n h\u1ED9i.
    Trong \u0111\xF3 ph\u1EA7n l\u1EC5 l\xE0 quan tr\u1ECDng th\u1EC3 hi\u1EC7n s\u1EF1
    b\xE1o hi\u1EC7u, t\u1ECF l\xF2ng th\xE0nh k\xEDnh bi\u1EBFt \u01A1n \u0111\u1ED1i
    v\u1EDBi \u0111\u1EA5ng sinh th\xE0nh."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
