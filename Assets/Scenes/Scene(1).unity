  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Th\u1EDDi gian: Th\u01B0\u1EDDng di\u1EC5n ra t\u1EEB th\xE1ng 12 \xE2m
    l\u1ECBch \u0111\u1EBFn th\xE1ng 3 \xE2m l\u1ECBch n\u0103m sau (sau khi thu
    ho\u1EA1ch xong m\xF9a v\u1EE5 ho\u1EB7c khi bu\xF4n l\xE0ng c\xF3 s\u1EF1 ki\u1EC7n
    l\u1EDBn). \n\n\u0110\u1ECBa \u0111i\u1EC3m: T\u1EA1i c\xE1c bu\xF4n l\xE0ng
    c\u1EE7a \u0111\u1ED3ng b\xE0o c\xE1c d\xE2n t\u1ED9c thi\u1EC3u s\u1ED1 T\xE2y
    Nguy\xEAn th\u01B0\u1EDDng t\u1ED5 ch\u1EE9c \u1EDF s\xE2n nh\xE0 r\xF4ng ho\u1EB7c
    b\xE3i \u0111\u1EA5t r\u1ED9ng c\u1EE7a c\u1ED9ng \u0111\u1ED3ng. \n\nL\u1EC5
    h\u1ED9i \u0111\xE2m tr\xE2u, hay c\xF2n \u0111\u01B0\u1EE3c g\u1ECDi l\xE0 l\u1EC5
    \u0103n tr\xE2u, l\xE0 m\u1ED9t nghi l\u1EC5 truy\u1EC1n th\u1ED1ng c\u1EE7a
    c\xE1c d\xE2n t\u1ED9c thi\u1EC3u s\u1ED1 \u1EDF T\xE2y Nguy\xEAn nh\u01B0 Ba
    Na, \xCA \u0110\xEA, Gia Rai, Cor, L\u1EA1ch\u2026 \u0110\xE2y l\xE0 nghi l\u1EC5
    hi\u1EBFn t\u1EBF con tr\xE2u \u0111\u1EC3 t\u1EA1 \u01A1n th\u1EA7n linh (Gi\xE0ng)
    \u0111\xE3 ph\xF9 h\u1ED9 cho m\xF9a m\xE0ng b\u1ED9i thu, d\xE2n l\xE0ng kh\u1ECFe
    m\u1EA1nh, \u0111\u1ED3ng th\u1EDDi c\u1EA7u mong m\u1ED9t n\u0103m m\u1EDBi
    m\u01B0a thu\u1EADn gi\xF3 h\xF2a. "
