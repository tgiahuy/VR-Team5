--- !u!114 &1131825221
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1131825219}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0110ing n\u0103m l\xE0 m\u1ED9t nh\u1EA1c c\u1EE5 h\u1ECD h\u01A1i c\u1EE7a
    m\u1ED9t s\u1ED1 d\xE2n t\u1ED9c \u1EDF T\xE2y Nguy\xEAn. \u0110ing n\u0103m
    l\xE0 c\xE1ch g\u1ECDi c\u1EE7a ng\u01B0\u1EDDi \xCA \u0110\xEA. Th\u01B0\u1EDDng
    d\xF9ng \u0111\u1EC3 th\u1ED5i theo \u0111i\u1EC7u h\xE1t Ayray, trong c\xE1c
    l\u1EC5 h\u1ED9i: L\u1EC5 c\xFAng B\u1EBFn n\u01B0\u1EDBc, l\u1EC5 c\u1EA7u m\u01B0a,
    l\u1EC5 m\u1EEBng l\xFAa m\u1EDBi, l\u1EC5 l\xEAn nh\xE0 m\u1EDBi, t\u0103ng
    l\u1EC5.v.v.. Trong c\xE1c l\u1EC5 h\u1ED9i n\xE0y nh\u1EA1c c\u1EE5 \u0111\u01B0\u1EE3c
    s\u1EED d\u1EE5ng h\xE1t hay ch\u1EC9 th\u1ED5i theo l\xE0n \u0111i\u1EC7u. \xC2m
    thanh tr\u1EA7m b\u1ED5ng, cao v\xFAt, v\u1ECDng vang kh\xE1c nhau, t\u1EA1o
    \u0111\u01B0\u1EE3c n\u1EBFt hoang s\u01A1 c\u1EE7a n\xFAi r\u1EEBng T\xE2y Nguy\xEAn,
    \xE2m thanh nh\u01B0 c\u01A1n l\u1ED1c x\xE9 to\u1EA1c c\u1EA3 m\u1EA3ng n\xFAi
    r\u1EEBng. Ng\u01B0\u1EDDi s\xE1ng t\u1EA1o ra \u0110ing n\u0103m v\xE0o th\u1EDDi
    gian n\xE0o nhi\u1EC1u ngh\u1EC7 nh\xE2n v\u1EABn kh\xF4ng bi\u1EBFt, h\u1ECD
    ch\u1EC9 bi\u1EBFt th\u1ED5i v\xE0 ca h\xE1t."
