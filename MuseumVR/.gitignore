# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity-generated directories
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/
/Recordings/

# Unity-generated files
Assets/AssetStoreTools*
sysinfo.txt
crashlytics-build.properties

# IDE and editor files
.idea/
.vscode/
.vs/
*.csproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity/Visual Studio generated metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Operating-system files
.DS_Store
Thumbs.db

# Crash reports
crashlytics-build.properties
sysinfo.txt

# Packed Addressables data
/Assets/AddressableAssetsData/*/*.bin*

# Temporary auto-generated test scenes
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*

# Blender files (nếu dùng Blender)
*.blend1
*.blend1.meta

# Visual Scripting generated files
/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta